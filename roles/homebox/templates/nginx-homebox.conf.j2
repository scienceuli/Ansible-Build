{{ ansible_managed | comment }}

server {
    listen 80;
    listen [::]:80;
    server_name {{ homebox_domain }};

    location /.well-known/acme-challenge/ {
        root {{ homebox_acme_challenge_root }};
    }

{% if ssl_active %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ homebox_domain }};

    ssl_certificate     {{ homebox_ssl_cert }};
    ssl_certificate_key {{ homebox_ssl_key }};

{% endif %}
    client_max_body_size {{ homebox_client_max_body_size }};

    location / {
        proxy_pass http://127.0.0.1:{{ homebox_host_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # HomeBox does file uploads (item photos, warranty docs) - don't buffer/timeout too eagerly
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
