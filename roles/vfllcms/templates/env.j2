{{ ansible_managed | comment }}
# Read by the web container (env_file in docker-compose.yml). Compose
# interpolates ${...} in env files: keep "$" out of the secrets.
SECRET_KEY={{ vfllcms_secret_key }}
DEBUG={{ vfllcms_debug }}
ALLOWED_HOSTS={{ vfllcms_domain }}
{% if vfllcms_db_containerized %}
DATABASE_URL=postgres://{{ vfllcms_db_user }}:{{ vfllcms_db_password | urlencode | replace('/', '%2F') }}@db:5432/{{ vfllcms_db_name }}
{% else %}
DATABASE_URL=postgres://{{ vfllcms_db_user }}:{{ vfllcms_db_password | urlencode | replace('/', '%2F') }}@{{ vfllcms_db_host }}:{{ vfllcms_db_port }}/{{ vfllcms_db_name }}
{% endif %}

VFLL_FACEBOOK_APP_ID={{ vfllcms_facebook_app_id }}
VFLL_FACEBOOK_APP_SECRET={{ vfllcms_facebook_app_secret }}
OPENAI_API_KEY={{ vfllcms_openai_api_key }}

EMAIL_BACKEND={{ vfllcms_email_backend }}
EMAIL_HOST={{ vfllcms_email_host }}
EMAIL_PORT={{ vfllcms_email_port }}
EMAIL_USE_TLS={{ vfllcms_email_use_tls }}
EMAIL_HOST_USER={{ vfllcms_email_host_user }}
EMAIL_HOST_PASSWORD={{ vfllcms_email_host_password }}

SHOW_JUBILEE={{ vfllcms_show_jubilee }}
ADMISSION_REGULATIONS={{ vfllcms_admission_regulations }}
TOKEN_URL={{ vfllcms_token_url }}
MEMBER_ADMIN_URL={{ vfllcms_member_admin_url }}
MEMBER_ADMIN_USER_USERNAME={{ vfllcms_member_admin_user }}
MEMBER_ADMIN_USER_SECRET={{ vfllcms_member_admin_secret }}
GOOGLE_CREDENTIALS={{ vfllcms_google_credentials }}
{% for key, value in vfllcms_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
