{{ ansible_managed | comment }}
# Read by the web and mailqueue containers (env_file in docker-compose.yml).
# Compose interpolates ${...} in env files: keep "$" out of the secrets.
SECRET_KEY={{ eventmanager_secret_key }}
DEBUG={{ eventmanager_debug }}
USE_2FA={{ eventmanager_use_2fa }}
LOG_LEVEL={{ eventmanager_log_level }}
SITE_URL={{ 'https' if eventmanager_enable_ssl else 'http' }}://{{ eventmanager_domain }}
ALLOWED_HOSTS={{ eventmanager_domain }}
DATABASE_URL=postgres://{{ eventmanager_db_user }}:{{ eventmanager_db_password | urlencode | replace('/', '%2F') }}@db:5432/{{ eventmanager_db_name }}
ENCRYPT_KEY={{ eventmanager_encrypt_key }}

EMAIL_BACKEND={{ eventmanager_email_backend }}
EMAIL_HOST={{ eventmanager_email_host }}
EMAIL_PORT={{ eventmanager_email_port }}
EMAIL_USE_TLS={{ eventmanager_email_use_tls }}
EMAIL_HOST_USER={{ eventmanager_email_host_user }}
EMAIL_HOST_PASSWORD={{ eventmanager_email_host_password }}

PAYPAL_ENABLED={{ eventmanager_paypal_enabled }}
PAYPAL_TEST={{ eventmanager_paypal_test }}
PAYPAL_RECEIVER_EMAIL={{ eventmanager_paypal_receiver_email }}

MAILGUN_API_KEY={{ eventmanager_mailgun_api_key }}
MAILGUN_URL={{ eventmanager_mailgun_url }}
MEMBER_ADMIN_URL={{ eventmanager_member_admin_url }}
TOKEN_URL={{ eventmanager_member_admin_token_url }}
MEMBER_ADMIN_USER_USERNAME={{ eventmanager_member_admin_user }}
MEMBER_ADMIN_USER_SECRET={{ eventmanager_member_admin_secret }}
INVOICE_NINJA_BASE_URL={{ eventmanager_invoice_ninja_base_url }}
INVOICE_NINJA_API_KEY={{ eventmanager_invoice_ninja_api_key }}
{% for key, value in eventmanager_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
