{{ ansible_managed | comment }}
[Unit]
Description=Publish Homebox label images to MQTT
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/homebox-label-watcher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
