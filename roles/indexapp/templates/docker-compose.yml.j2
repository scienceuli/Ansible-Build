{{ ansible_managed | comment }}
name: "{{ indexapp_name }}"
services:
  db:
    image: "{{ indexapp_db_image }}"
    container_name: "{{ indexapp_name }}-db"
    restart: "{{ indexapp_restart_policy }}"
    environment:
      POSTGRES_DB: "{{ indexapp_db_name }}"
      POSTGRES_USER: "{{ indexapp_db_user }}"
      POSTGRES_PASSWORD: {{ indexapp_db_password | replace('$', '$$') | to_json }}
    volumes:
      - "{{ indexapp_db_data_dir }}:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ indexapp_db_user }} -d {{ indexapp_db_name }}"]
      interval: 5s
      retries: 20

  redis:
    image: "{{ indexapp_redis_image }}"
    container_name: "{{ indexapp_name }}-redis"
    restart: "{{ indexapp_restart_policy }}"
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - "{{ indexapp_redis_data_dir }}:/data"

  web:
    build: ./src
    image: "{{ indexapp_name }}:latest"
    container_name: "{{ indexapp_name }}"
    restart: "{{ indexapp_restart_policy }}"
    command: ["web"]          # migrations, then gunicorn (docker/entrypoint.sh)
    env_file: .env
    # reached by the nginx container as {{ indexapp_name }}:8000; no published port
    networks:
      - default
      - proxy
    volumes:
      - "{{ indexapp_data_dir }}:/data"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started

  worker:
    image: "{{ indexapp_name }}:latest"
    pull_policy: never        # built locally by the web service
    container_name: "{{ indexapp_name }}-worker"
    restart: "{{ indexapp_restart_policy }}"
    command: ["worker"]
    env_file: .env
    volumes:
      - "{{ indexapp_data_dir }}:/data"
    depends_on:
      - web

networks:
  proxy:
    name: "{{ indexapp_network }}"
    external: true
