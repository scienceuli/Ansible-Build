{{ ansible_managed | comment }}
APP_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY={{ indexapp_secret_key }}
DATABASE_URL=postgresql://{{ indexapp_db_user }}:{{ indexapp_db_password | urlencode | replace('/', '%2F') }}@db/{{ indexapp_db_name }}
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
JOB_TIMEOUT={{ indexapp_job_timeout }}

DATA_DIR=/data
MAX_UPLOAD_MB={{ indexapp_max_upload_mb }}
X_ACCEL_PREFIX={{ indexapp_x_accel_prefix }}

APP_PRIMARY_DOMAIN={{ indexapp_domain }}
PREFERRED_URL_SCHEME=https
# nginx container in front; gunicorn is only reachable over the docker networks
TRUST_PROXY=1
GUNICORN_FORWARDED_ALLOW_IPS=*
GUNICORN_WORKERS={{ indexapp_gunicorn_workers }}
LOG_LEVEL={{ indexapp_log_level }}

MAIL_SERVER={{ indexapp_mail_server }}
MAIL_PORT={{ indexapp_mail_port }}
MAIL_USE_TLS={{ indexapp_mail_use_tls | lower }}
MAIL_USERNAME={{ indexapp_mail_username }}
MAIL_PASSWORD={{ indexapp_mail_password }}
MAIL_DEFAULT_SENDER={{ indexapp_mail_default_sender }}
