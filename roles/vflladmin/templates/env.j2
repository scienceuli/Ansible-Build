{{ ansible_managed | comment }}
# Read by the web and worker containers (env_file in docker-compose.yml).
# Compose interpolates ${...} in env files: keep "$" out of the secrets.
SECRET_KEY={{ vflladmin_secret_key }}
DEBUG={{ vflladmin_debug }}
USE_2FA={{ vflladmin_use_2fa }}
LOG_LEVEL={{ vflladmin_log_level }}
{% set _scheme = 'https' if vflladmin_enable_ssl else 'http' %}
{% set _hosts = [vflladmin_domain] + vflladmin_domain_aliases %}
SITE_URL={{ _scheme }}://{{ vflladmin_domain }}
ALLOWED_HOSTS={{ _hosts | join(',') }}
CSRF_TRUSTED_ORIGINS={{ _hosts | map('regex_replace', '^', _scheme ~ '://') | join(',') }}
DATABASE_URL=postgres://{{ vflladmin_db_user }}:{{ vflladmin_db_password | urlencode | replace('/', '%2F') }}@db:5432/{{ vflladmin_db_name }}
CELERY_BROKER_URL=redis://redis:6379/0
CREATE_INVOICE_PDFS_IN_BACKGROUND={{ vflladmin_pdfs_in_background }}
SEND_INVOICE_MAILS_IN_BACKGROUND={{ vflladmin_mails_in_background }}

EMAIL_BACKEND_VIA={{ vflladmin_email_backend_via }}
DEFAULT_FROM_EMAIL={{ vflladmin_default_from_email }}
EMAIL_HOST={{ vflladmin_email_host }}
EMAIL_PORT={{ vflladmin_email_port }}
EMAIL_USE_TLS={{ vflladmin_email_use_tls }}
EMAIL_HOST_USER={{ vflladmin_email_host_user }}
EMAIL_HOST_PASSWORD={{ vflladmin_email_host_password }}
EMAIL_BATCH_SIZE={{ vflladmin_email_batch_size }}
EMAIL_BATCH_PAUSE={{ vflladmin_email_batch_pause }}
MAILTRAP_API_TOKEN={{ vflladmin_mailtrap_api_token }}
MAILTRAP_USE_SANDBOX={{ vflladmin_mailtrap_use_sandbox }}
MAILTRAP_INBOX_ID={{ vflladmin_mailtrap_inbox_id }}
{% for key, value in vflladmin_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
