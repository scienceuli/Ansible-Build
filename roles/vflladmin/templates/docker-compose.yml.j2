{{ ansible_managed | comment }}
name: "{{ vflladmin_name }}"

services:
  db:
    image: "{{ vflladmin_db_image }}"
    container_name: "{{ vflladmin_name }}-db"
    restart: "{{ vflladmin_restart_policy }}"
    environment:
      POSTGRES_DB: "{{ vflladmin_db_name }}"
      POSTGRES_USER: "{{ vflladmin_db_user }}"
      POSTGRES_PASSWORD: {{ vflladmin_db_password | replace('$', '$$') | to_json }}
    volumes:
      - "{{ vflladmin_db_data_dir }}:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ vflladmin_db_user }} -d {{ vflladmin_db_name }}"]
      interval: 5s
      retries: 20

  # celery broker only, nothing persistent
  redis:
    image: "{{ vflladmin_redis_image }}"
    container_name: "{{ vflladmin_name }}-redis"
    restart: "{{ vflladmin_restart_policy }}"
    command: ["redis-server", "--save", "", "--appendonly", "no"]

  web:
    build: ./src
    image: "{{ vflladmin_name }}:latest"
    container_name: "{{ vflladmin_name }}"
    restart: "{{ vflladmin_restart_policy }}"
    command: ["gunicorn", "vflladmin.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "{{ vflladmin_gunicorn_workers }}", "--timeout", "120", "--access-logfile", "-"]
    env_file: .env
    environment:
      RUN_MIGRATIONS: "1"
    # Reached by the nginx container as {{ vflladmin_name }}:8000
    networks:
      - default
      - proxy
    volumes:
      - "{{ vflladmin_data_dir }}:/data"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started

  # Invoice PDFs and invoice mails (celery tasks)
  worker:
    image: "{{ vflladmin_name }}:latest"
    pull_policy: never    # built locally by the web service
    container_name: "{{ vflladmin_name }}-worker"
    restart: "{{ vflladmin_restart_policy }}"
    command: ["celery", "-A", "vflladmin", "worker", "--loglevel=INFO", "--concurrency={{ vflladmin_celery_concurrency }}"]
    env_file: .env
    volumes:
      - "{{ vflladmin_data_dir }}:/data"
    depends_on:
      - web
      - redis

networks:
  proxy:
    name: "{{ vflladmin_network }}"
    external: true
