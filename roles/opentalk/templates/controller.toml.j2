{{ ansible_managed | comment }}
# Based on extras/opentalk-samples/controller.toml.sample of ot-setup {{ opentalk_release }}.
# Hostnames postgres, rabbit, garage, livekit: compose services of {{ opentalk_name }}.

[frontend]
base_url = "https://{{ opentalk_domain }}"

{% if opentalk_data_protection_url or opentalk_error_report_address %}
[operator_information]
{% if opentalk_data_protection_url %}
data_protection_url = {{ opentalk_data_protection_url | to_json }}
{% endif %}
{% if opentalk_error_report_address %}
support_email_address = {{ opentalk_error_report_address | to_json }}
{% endif %}

{% endif %}
[database]
url = {{ ('postgres://' ~ opentalk_postgres_user ~ ':' ~ (opentalk_postgres_password | urlencode | replace('/', '%2F')) ~ '@postgres:5432/' ~ opentalk_postgres_db) | to_json }}

[http]
port = 11311
# API key of the (here: internal) roomserver for the controller's service APIs
service_api_keys = [{ "id" = "controller", "secret" = {{ opentalk_service_api_secret | to_json }} }]

# (replaces the deprecated [keycloak] section of the ot-setup sample)
# Discovery goes via the public URL, i.e. through the host's nginx
[oidc]
authority = "https://{{ opentalk_accounts_domain }}/auth/realms/{{ opentalk_keycloak_realm }}"

[oidc.frontend]
client_id = "OtFrontend"

[oidc.controller]
client_id = "OtBackend"
client_secret = {{ opentalk_keycloak_client_secret_controller | to_json }}

[user_search]
backend = "keycloak_webapi"
api_base_url = "https://{{ opentalk_accounts_domain }}/auth/admin/realms/{{ opentalk_keycloak_realm }}"
# ot-setup default (USERS_FIND_USE_KC=false): only users who logged in before
users_find_behavior = "from_database"

[minio]
uri = "http://garage:3900"
bucket = "{{ opentalk_garage_bucket }}"
access_key = {{ opentalk_garage_access_key_id | to_json }}
secret_key = {{ opentalk_garage_secret_key | to_json }}

[rabbit_mq]
url = "amqp://rabbit/%2F"
# no smtp-mailer / recorder deployed: queues not set, so nothing piles up
{% if opentalk_feature_recording %}
recording_task_queue = "opentalk_recorder"
{% endif %}

[roomserver]
# embedded in the controller process (single host)
kind = "internal"
public_url = "https://{{ opentalk_controller_domain }}"

[roomserver.conference]
signaling_salt = {{ opentalk_signaling_salt | to_json }}

[roomserver.defaults]
screen_share_requires_permission = false

[roomserver.reports.typst]
packages_path = "/usr/share/typst/packages"

[roomserver.websocket_rate_limit]
disabled = false
tokens_per_second = 10
token_bucket_size = 30

[roomserver.modules]
[roomserver.modules.chat]
[roomserver.modules.chat.rate_limit]
tokens_per_second = 3
token_bucket_size = 10
slow_down_threshold = 0.8
[roomserver.modules.e2ee]
[roomserver.modules.livekit]
api_key = "{{ opentalk_livekit_api_key }}"
api_secret = {{ opentalk_livekit_api_secret | to_json }}
public_url = "https://{{ opentalk_livekit_domain }}"
service_url = "http://livekit:7880"
[roomserver.modules.echo]
[roomserver.modules.polls]
[roomserver.modules.timer]
[roomserver.modules.training_participation_report]
[roomserver.modules.excalidraw]
[roomserver.modules.reaction]
[roomserver.modules.automod]
[roomserver.modules.legal_vote]
[roomserver.modules.meeting_report]
[roomserver.modules.moderation]
[roomserver.modules.raise_hands]
[roomserver.modules.shared_folder]
[roomserver.modules.subroom_audio]

[defaults]
user_language = "{{ opentalk_default_language }}"
timezone = "{{ opentalk_timezone }}"
